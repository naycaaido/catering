// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  PAUSE
  CANCLE
}

model User {
  id              String           @id @default(uuid())
  email           String
  password        String
  created_at      DateTime         @default(now())
  role            Role             @default(USER)
  customerProfile CustomerProfile?
  adminProfile    AdminProfile?
}

model CustomerProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  fullName      String
  phoneNumber   String
  created_at    DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  testimonial   Testimonial[]
  address       Address[]
}

model AdminProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  fullName   String
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Address {
  id              String           @id @default(uuid())
  customerId      String
  label           String
  detailAlamat    String
  isDefault       Boolean
  created_at      DateTime         @default(now())
  customerProfile CustomerProfile? @relation(fields: [customerId], references: [id])
}

model Testimonial {
  id              String          @id @default(uuid())
  customerId      String
  subscriptionId  String?
  review          String
  rating          Int
  customerProfile CustomerProfile @relation(fields: [customerId], references: [id])
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
}

model Subscription {
  id                String          @id @default(uuid())
  userId            String
  phoneNumber       String
  planId            String          @unique
  mealType          String
  deliveryDays      String
  allergies         String
  status            Status
  endDate           DateTime
  pausePeriodeStart DateTime
  pausePeriodeEnd   DateTime
  customerProfile   CustomerProfile @relation(fields: [userId], references: [id])
  mealPlans         MealPlan        @relation(fields: [planId], references: [id])
  testimonials      Testimonial[]
}

model MealPlan {
  id           String        @id @default(uuid())
  name         String
  price        Int
  description  String
  imageUrl     String?
  subscription Subscription?
}
